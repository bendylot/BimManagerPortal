@using BimManagerPortal.Shared.Dtos
@using BimManagerPortal.WebAssembly.Components.ModalForm.Loading
@using BimManagerPortal.WebAssembly.Layout.Modals.LoadingModal
@inject LoadingModalService LoadingModalService
<div class="container-box p-3">
    <div class="row mb-4 align-items-center g-2">
        <div class="col-md-4">
            <input type="text"
                   class="form-control"
                   style="height: 31px;"
                   placeholder="Поиск по названию..."
                   value="@_searchTerm"
                   @oninput="OnSearchInput" />
        </div>

        <div class="col-md-8" style="min-height: 31px;">
            @if (_selectedId != null)
            {
                <div class="d-flex gap-2 justify-content-md-start">
                    <button class="btn btn-outline-primary d-flex align-items-center btn-sm"
                            @onclick="ReadPluginReport">
                        <i class="bi bi-pencil-square me-1"></i> Прочитать отчет
                    </button>

                    <button class="btn btn-outline-secondary d-flex align-items-center btn-sm"
                            @onclick="DownloadJson">
                        <i class="bi bi-download me-1"></i> Скачать JSON
                    </button>

                    <button class="btn btn-outline-danger d-flex align-items-center btn-sm"
                            @onclick="DeletePluginReport">
                        <i class="bi bi-trash me-1"></i> Удалить отчет
                    </button>
                </div>
            }
        </div>
    </div>

    @if (!_pagedResult.Items.Any())
    {
        <div class="alert alert-light text-muted border-dashed" style="border: 2px dashed #eee;">
            Конфигурации не найдены.
        </div>
    }
    else
    {
        <div class="minimal-table-container">
            <div class="table-wrapper">
                <table class="minimal-table">
                    <thead>
                        <tr>
                            <th style="cursor:pointer" @onclick='() => SortBy("ConfigurationName")'>
                                Имя конфигурации @SortIcon("ConfigurationName")
                            </th>
                            <th style="cursor:pointer" @onclick='() => SortBy("CreatedAt")'>
                                Дата создания @SortIcon("CreatedAt")
                            </th>
                            <th style="cursor:pointer" @onclick='() => SortBy("UserCreater")'>
                                Пользователь @SortIcon("UserCreater")
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var config in _pagedResult.Items)
                        {
                            <tr @onclick="() => SelectRow(config.Id)"
                                class="@(_selectedId == config.Id ? "selected" : "")">
                                <td style="font-weight: 500;">@config.ConfigurationName</td>
                                <td style="font-weight: 500;">@config.CreatedAt</td>
                                <td style="font-weight: 500;">@config.UserCreater</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Pagination -->
        @if (_pagedResult.TotalPages > 1)
        {
            <div class="d-flex align-items-center justify-content-between mt-3 flex-wrap gap-2">
                <small class="text-muted">
                    Показано @((_currentPage - 1) * PageSize + 1)–@(Math.Min(_currentPage * PageSize, _pagedResult.TotalCount))
                    из @_pagedResult.TotalCount
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(_currentPage == 1 ? "disabled" : "")">
                            <button class="page-link" type="button" @onclick="() => GoToPage(_currentPage - 1)">‹</button>
                        </li>

                        @foreach (var p in GetPageNumbers())
                        {
                            @if (p == -1)
                            {
                                <li class="page-item disabled"><span class="page-link">…</span></li>
                            }
                            else
                            {
                                <li class="page-item @(p == _currentPage ? "active" : "")">
                                    <button class="page-link" type="button" @onclick="() => GoToPage(p)">@p</button>
                                </li>
                            }
                        }

                        <li class="page-item @(_currentPage == _pagedResult.TotalPages ? "disabled" : "")">
                            <button class="page-link" type="button" @onclick="() => GoToPage(_currentPage + 1)">›</button>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
</div>
<LoadingModal />