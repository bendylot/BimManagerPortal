@using BimManagerPortal.Shared.Model

<div class="report-container">
    <!-- Header -->
    <div class="report-header">
        <div class="report-title-row">
            <h3 class="report-title">Отчёт: Запретные зоны</h3>
        </div>
        <div class="header-gradient"></div>
    </div>

    <!-- Основная информация -->
    <div class="info-card">
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Пользователь</span>
                <span class="info-value">@RestrictedAreaReportModel.CommonInformationBuilding?.UserName</span>
            </div>
            <div class="info-item">
                <span class="info-label">Версия плагина</span>
                <span class="info-value">@RestrictedAreaReportModel.CommonInformationBuilding?.PluginVersion</span>
            </div>
            <div class="info-item">
                <span class="info-label">Начало обработки</span>
                <span class="info-value">@FormatDate(RestrictedAreaReportModel.CommonInformationBuilding?.DateStartProcess)</span>
            </div>
            <div class="info-item">
                <span class="info-label">Окончание обработки</span>
                <span class="info-value">@FormatDate(RestrictedAreaReportModel.CommonInformationBuilding?.DateEndProcess)</span>
            </div>
            <div class="info-item highlight">
                <span class="info-label">Общее время</span>
                <span class="info-value">@FormatTimeSpan(RestrictedAreaReportModel.CommonInformationBuilding?.ComputeProcessTime)</span>
            </div>
        </div>
    </div>

    <!-- Сводная статистика -->
    @{
        var summary = ComputeSummary();
    }
    @if (summary.TotalDocuments > 0)
    {
        <div class="summary-card">
            <div class="summary-title">Сводная статистика</div>
            <div class="summary-grid">
                <div class="summary-item">
                    <span class="summary-value">@summary.TotalObjects</span>
                    <span class="summary-label">Объектов</span>
                </div>
                <div class="summary-item">
                    <span class="summary-value">@summary.TotalDocuments</span>
                    <span class="summary-label">Документов</span>
                </div>
                <div class="summary-item success">
                    <span class="summary-value">@summary.TotalCreated</span>
                    <span class="summary-label">Создано зон</span>
                </div>
                <div class="summary-item danger">
                    <span class="summary-value">@summary.TotalBadNotCreated</span>
                    <span class="summary-label">Не создано (ошибки)</span>
                </div>
                <div class="summary-item deleted">
                    <span class="summary-value">@summary.TotalDeletedZones</span>
                    <span class="summary-label">Удалено старых зон</span>
                </div>
                <div class="summary-item busy">
                    <span class="summary-value">@summary.TotalBusyZones</span>
                    <span class="summary-label">Занятых зон (не удалено)</span>
                </div>
                <div class="summary-item info">
                    <span class="summary-value">@summary.TotalSavedZones</span>
                    <span class="summary-label">Сохранено зон</span>
                </div>
            </div>
        </div>
    }

    <!-- Объекты конфигуратора -->
    @if (RestrictedAreaReportModel.ObjectConiguratorData?.Any() == true)
    {
        <div class="objects-container">
            @foreach (var (objectData, objIndex) in RestrictedAreaReportModel.ObjectConiguratorData.Select((o, i) => (o, i)))
            {
                var objExpanded = _expandedObjects.Contains(objIndex);
                var objStats = ComputeObjectStats(objectData);

                <div class="object-card">
                    <div class="object-header collapsible" @onclick="() => ToggleSet(_expandedObjects, objIndex)">
                        <span class="collapse-arrow">@(objExpanded ? "▼" : "▶")</span>
                        <h4 class="object-title">@objectData.ObjectName</h4>
                        <div class="object-badges">
                            @if (objStats.Created > 0)
                            {
                                <span class="badge badge-success">✓ @objStats.Created</span>
                            }
                            @if (objStats.BadErrors > 0)
                            {
                                <span class="badge badge-danger">✗ @objStats.BadErrors</span>
                            }
                            @if (objStats.DocErrors > 0)
                            {
                                <span class="badge badge-warning">⚠ @objStats.DocErrors</span>
                            }
                        </div>
                        <div class="object-time-badge">@FormatTimeSpan(objectData.ComputeProcessTime)</div>
                    </div>

                    @if (objExpanded)
                    {
                        @if (objectData.SectionsBuildingData?.Any() == true)
                        {
                            <div class="sections-container">
                                @foreach (var (section, secIndex) in objectData.SectionsBuildingData.Select((s, i) => (s, i)))
                                {
                                    var secStats = ComputeSecStats(section);
                                    var secKey = objIndex * 10000 + secIndex;
                                    var secExpanded = _expandedSections.Contains(secKey);

                                    <div class="section-card">
                                        <div class="section-header collapsible" @onclick="() => ToggleSet(_expandedSections, secKey)">
                                            <span class="collapse-arrow">@(secExpanded ? "▼" : "▶")</span>
                                            <h5 class="section-title">@(section.SectionBuildingDataName)</h5>
                                            <div class="section-badges">
                                                @if (secStats.Created > 0)
                                                {
                                                    <span class="badge badge-success">✓ @secStats.Created</span>
                                                }
                                                @if (secStats.BadErrors > 0)
                                                {
                                                    <span class="badge badge-danger">✗ @secStats.BadErrors</span>
                                                }
                                                @if (secStats.DocErrors > 0)
                                                {
                                                    <span class="badge badge-warning">⚠ @secStats.DocErrors</span>
                                                }
                                            </div>
                                            <span class="section-doc-count">@(section.DocumentsBuildingData?.Count ?? 0) докум.</span>
                                            <span class="section-time">@FormatTimeSpan(section.ComputeProcessTime)</span>
                                        </div>

                                        @if (secExpanded)
                                        {
                                            @if (section.DocumentsBuildingData?.Any() == true)
                                            {
                                                <div class="documents-container">
                                                    @foreach (var (document, docIndex) in section.DocumentsBuildingData.Select((d, i) => (d, i)))
                                                    {
                                                        var docKey = secKey * 10000 + docIndex;
                                                        var docExpanded = _expandedDocuments.Contains(docKey);
                                                        var docStats = ComputeDocStats(document);

                                                        <div class="document-card">
                                                            <div class="document-header collapsible" @onclick="() => ToggleSet(_expandedDocuments, docKey)">
                                                                <span class="collapse-arrow">@(docExpanded ? "▼" : "▶")</span>
                                                                <div class="document-title-wrapper">
                                                                    <span class="document-name">@document.DocumentTitle</span>
                                                                    <span class="document-section-badge">@(document.DocumentSection)</span>
                                                                </div>
                                                                <div class="doc-mini-stats">
                                                                    @if (docStats.Created > 0)
                                                                    {
                                                                        <span class="mini-badge success">✓ @docStats.Created</span>
                                                                    }
                                                                    @if (docStats.Bad > 0)
                                                                    {
                                                                        <span class="mini-badge danger">✗ @docStats.Bad</span>
                                                                    }
                                                                </div>
                                                                <span class="document-time">@FormatTimeSpan(document.ComputeProcessTime)</span>
                                                            </div>

                                                            @if (docExpanded)
                                                            {
                                                                @if (document.EntityBuildingData?.Any() == true)
                                                                {
                                                                    <div class="entities-container">
                                                                        @foreach (var (entity, entIndex) in document.EntityBuildingData.Select((e, i) => (e, i)))
                                                                        {
                                                                            var entKey = docKey * 10000 + entIndex;

                                                                            <div class="entity-card">
                                                                                <div class="entity-header">
                                                                                    <span class="entity-name">@entity.EntityName</span>
                                                                                    <span class="entity-time">@FormatTimeSpan(entity.ComputeProcessTime)</span>
                                                                                </div>

                                                                                <div class="stats-grid">
                                                                                    @if (entity.HostElements?.Any() == true)
                                                                                    {
                                                                                        <div class="stat-item">
                                                                                            <span class="stat-label">Хост элементы</span>
                                                                                            <span class="stat-value">@entity.HostElements.Count</span>
                                                                                            <button class="btn-show-ids" @onclick:stopPropagation="true"
                                                                                                    @onclick="() => ToggleSet(_expandedHostElements, entKey)">
                                                                                                @(_expandedHostElements.Contains(entKey) ? "▲" : "▼")
                                                                                            </button>
                                                                                        </div>
                                                                                    }
                                                                                    @if (entity.CreatedElements?.Any() == true)
                                                                                    {
                                                                                        <div class="stat-item">
                                                                                            <span class="stat-label">Создано</span>
                                                                                            <span class="stat-value success-text">@entity.CreatedElements.Count</span>
                                                                                            <button class="btn-show-ids success" @onclick:stopPropagation="true"
                                                                                                    @onclick="() => ToggleSet(_expandedCreatedElements, entKey)">
                                                                                                @(_expandedCreatedElements.Contains(entKey) ? "▲" : "▼")
                                                                                            </button>
                                                                                        </div>
                                                                                    }
                                                                                    @if (entity.SavedOldZones?.Any() == true)
                                                                                    {
                                                                                        <div class="stat-item">
                                                                                            <span class="stat-label">Сохранено старых зон</span>
                                                                                            <span class="stat-value info-text">@entity.SavedOldZones.Count</span>
                                                                                            <button class="btn-show-ids info" @onclick:stopPropagation="true"
                                                                                                    @onclick="() => ToggleSet(_expandedSavedZones, entKey)">
                                                                                                @(_expandedSavedZones.Contains(entKey) ? "▲" : "▼")
                                                                                            </button>
                                                                                        </div>
                                                                                    }
                                                                                </div>

                                                                                @if (_expandedHostElements.Contains(entKey) && entity.HostElements?.Any() == true)
                                                                                {
                                                                                    <div class="ids-chips-list">
                                                                                        @foreach (var el in entity.HostElements)
                                                                                        {
                                                                                            <span class="id-chip neutral">@el.ElementId</span>
                                                                                        }
                                                                                    </div>
                                                                                }

                                                                                @if (_expandedCreatedElements.Contains(entKey) && entity.CreatedElements?.Any() == true)
                                                                                {
                                                                                    <div class="ids-chips-list">
                                                                                        @foreach (var el in entity.CreatedElements)
                                                                                        {
                                                                                            <span class="id-chip success">@el.ElementId</span>
                                                                                        }
                                                                                    </div>
                                                                                }

                                                                                @if (_expandedSavedZones.Contains(entKey) && entity.SavedOldZones?.Any() == true)
                                                                                {
                                                                                    <div class="ids-chips-list">
                                                                                        @foreach (var el in entity.SavedOldZones)
                                                                                        {
                                                                                            <span class="id-chip info">@el.ElementId</span>
                                                                                        }
                                                                                    </div>
                                                                                }

                                                                                @if (entity.NotCreatedElementsData != null)
                                                                                {
                                                                                    <div class="errors-container">
                                                                                        @if (entity.NotCreatedElementsData.GoodNotCreatedElements?.Any() == true)
                                                                                        {
                                                                                            <div class="error-group good">
                                                                                                <div class="error-group-header">
                                                                                                    <span class="error-group-title">Не создано (допустимо)</span>
                                                                                                    <span class="error-count">@entity.NotCreatedElementsData.GoodNotCreatedElements.Count</span>
                                                                                                    <button class="btn-toggle-ids good" @onclick:stopPropagation="true"
                                                                                                            @onclick="() => ToggleSet(_expandedGoodErrors, entKey)">
                                                                                                        @(_expandedGoodErrors.Contains(entKey) ? "▲" : "▼")
                                                                                                    </button>
                                                                                                </div>
                                                                                                @if (_expandedGoodErrors.Contains(entKey))
                                                                                                {
                                                                                                    <div class="ids-list">
                                                                                                        @foreach (var elem in entity.NotCreatedElementsData.GoodNotCreatedElements)
                                                                                                        {
                                                                                                            <div class="id-row">
                                                                                                                <span class="id-badge good">@elem.BadElementId</span>
                                                                                                                <span class="id-reason">@elem.ReasonNotCreated</span>
                                                                                                            </div>
                                                                                                        }
                                                                                                    </div>
                                                                                                }
                                                                                            </div>
                                                                                        }

                                                                                        @if (entity.NotCreatedElementsData.BadNotCreatedElements?.Any() == true)
                                                                                        {
                                                                                            <div class="error-group bad">
                                                                                                <div class="error-group-header">
                                                                                                    <span class="error-group-title">Не создано (ошибки)</span>
                                                                                                    <span class="error-count">@entity.NotCreatedElementsData.BadNotCreatedElements.Count</span>
                                                                                                    <button class="btn-toggle-ids" @onclick:stopPropagation="true"
                                                                                                            @onclick="() => ToggleSet(_expandedBadErrors, entKey)">
                                                                                                        @(_expandedBadErrors.Contains(entKey) ? "▲" : "▼")
                                                                                                    </button>
                                                                                                </div>
                                                                                                @if (_expandedBadErrors.Contains(entKey))
                                                                                                {
                                                                                                    <div class="ids-list">
                                                                                                        @foreach (var elem in entity.NotCreatedElementsData.BadNotCreatedElements)
                                                                                                        {
                                                                                                            <div class="id-row">
                                                                                                                <span class="id-badge">@elem.BadElementId</span>
                                                                                                                <span class="id-reason">@elem.ReasonNotCreated</span>
                                                                                                            </div>
                                                                                                        }
                                                                                                    </div>
                                                                                                }
                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                }

                                                                @if (document.DocumentDeletingZonesResult != null)
                                                                {
                                                                    <div class="zones-result">
                                                                        <div class="zones-section-title">Результаты удаления зон</div>
                                                                        <div class="zones-grid">
                                                                            @if (document.DocumentDeletingZonesResult.DeletedOldZones?.Any() == true)
                                                                            {
                                                                                var delKey = docKey + 1000000;
                                                                                <div class="zone-stat-row">
                                                                                    <span class="zone-label">Удалено старых</span>
                                                                                    <span class="zone-value deleted">@document.DocumentDeletingZonesResult.DeletedOldZones.Count</span>
                                                                                    <button class="btn-show-ids danger" @onclick:stopPropagation="true"
                                                                                            @onclick="() => ToggleSet(_expandedDeletedZones, delKey)">
                                                                                        @(_expandedDeletedZones.Contains(delKey) ? "▲" : "▼")
                                                                                    </button>
                                                                                </div>
                                                                                @if (_expandedDeletedZones.Contains(delKey))
                                                                                {
                                                                                    <div class="ids-chips-list full-width">
                                                                                        @foreach (var id in document.DocumentDeletingZonesResult.DeletedOldZones)
                                                                                        {
                                                                                            <span class="id-chip danger">@id</span>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            }
                                                                            @if (document.DocumentDeletingZonesResult.NotDeletedBusyOldZones?.Any() == true)
                                                                            {
                                                                                var busyKey = docKey + 2000000;
                                                                                <div class="zone-stat-row">
                                                                                    <span class="zone-label">Не удалено (занято)</span>
                                                                                    <span class="zone-value busy">@document.DocumentDeletingZonesResult.NotDeletedBusyOldZones.Count</span>
                                                                                    <button class="btn-show-ids warning" @onclick:stopPropagation="true"
                                                                                            @onclick="() => ToggleSet(_expandedNotDeletedZones, busyKey)">
                                                                                        @(_expandedNotDeletedZones.Contains(busyKey) ? "▲" : "▼")
                                                                                    </button>
                                                                                </div>
                                                                                @if (_expandedNotDeletedZones.Contains(busyKey))
                                                                                {
                                                                                    <div class="ids-chips-list full-width">
                                                                                        @foreach (var el in document.DocumentDeletingZonesResult.NotDeletedBusyOldZones)
                                                                                        {
                                                                                            <span class="id-chip warning">@el.ElementId</span>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (objectData.ErrorDocumentHandler?.Any() == true)
                        {
                            var errDocKey = objIndex + 5000000;
                            <div class="errors-section">
                                <div class="errors-header collapsible" @onclick="() => ToggleSet(_expandedErrorDocs, errDocKey)">
                                    <span class="collapse-arrow">@(_expandedErrorDocs.Contains(errDocKey) ? "▼" : "▶")</span>
                                    <span class="errors-title">Ошибки обработки документов</span>
                                    <span class="errors-count">@objectData.ErrorDocumentHandler.Count</span>
                                </div>
                                @if (_expandedErrorDocs.Contains(errDocKey))
                                {
                                    <div class="error-docs-list">
                                        @foreach (var err in objectData.ErrorDocumentHandler)
                                        {
                                            <div class="error-doc-item">
                                                <span class="error-doc-path">@err.ModelPath</span>
                                                <span class="error-doc-reason">@err.ReasonNotCreated</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
            }
        </div>
    }
</div>
