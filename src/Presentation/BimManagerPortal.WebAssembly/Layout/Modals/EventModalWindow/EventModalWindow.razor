@if (_isVisible)
{
    <div class="event-toast border @BorderClass">
        <div class="event-toast-header">
            <i class="@IconClass me-2"></i>
            <strong class="me-auto">@Title</strong>
            <button type="button" class="btn-close btn-close-sm ms-2" @onclick="Close"></button>
        </div>
        <div class="event-toast-body">
            @Message
        </div>
    </div>
}
